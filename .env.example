# Discord
DISCORD_TOKEN=
SERVER_ID=

# Channels
WELCOME_CHANNEL_ID=
ANNOUNCEMENT_CHANNEL_ID=
SCHEDULE_CHANNEL_ID=
LEADERSHIP_SCHEDULE_CHANNEL_ID=
CALENDAR_CHANNEL_ID=
TODAY_CHANNEL_ID=
AWAY_CHANNEL_ID=
AUDIT_CHANNEL_ID=
CHEST_CHANNEL_ID=

# Roles
ANNOUNCEMENT_PING_ROLE_ID=
LEADERSHIP_ROLE_IDS=
RANK_ROLE_MAP=
LANGUAGE_ROLE_MAP=
AWAY_ROLE_ID=
UNVERIFIED_ROLE_ID=
VERIFIED_ROLE_ID=
SPECIAL_ACCESS_ROLE_ID=

# Authoritative OZY data
ROSTER_URL=https://ozy.com.ar/api/v1/roster
ROSTER_FILE=data/roster.json
CHEST_DATA_URL=https://ozy.com.ar/api/v1/chests/current
CHEST_DATA_FILE=data/chest_data.json
OZY_DATA_API_TOKEN=
SCHEDULE_URL=https://ozy.com.ar/api/ozy/schedule
SCHEDULE_FILE=data/schedule.json
CHATS_FILE=data/chats.json
DATA_CACHE_SECONDS=60
HTTP_TIMEOUT_SECONDS=10

# Scheduling
SCHEDULE_TIMEZONE=America/Argentina/Buenos_Aires
DAILY_SCHEDULE_ENABLED=true
DAILY_SCHEDULE_TIME=08:00

# Tournament calendar
CALENDAR_ENABLED=true
CALENDAR_BASE_URL=https://nexusportal.voltron.me
CALENDAR_REALM=Regular
CALENDAR_REFRESH_MINUTES=30
CALENDAR_DAYS=30
CALENDAR_MIN_ACTIONS=10
TODAY_ENABLED=true

# Membership / access
AUTO_SYNC_NICKNAME=false
ROSTER_ACCESS_SYNC_MINUTES=10

# Chest ranking
CHEST_RESET_POST_ENABLED=true
CHEST_RESET_POST_TIME_UTC=17:00
CHEST_REPORT_CHUNK_SIZE=20

# Durable bot state - SQLite working copy + authenticated OZY web snapshot
STATE_DB=data/ozy_admin.sqlite3
STATE_REMOTE_URL=https://ozy.com.ar/api/ozy-admin/state
STATE_REMOTE_TOKEN=
STATE_REMOTE_TIMEOUT_SECONDS=10

# Render / health
PORT=10000
SELF_PING_ENABLED=true
SELF_PING_INTERVAL_SECONDS=600
